        "scope": "squad",
        "effect": "empower",
        "firedLabel": "Beat!",
        "strike": {
          "damageMultiplier": 0.8,
          "damageType": "ranged"
        }
      }
    },
    "skills": {
      "attack": "crescendo",
      "support": "ballad_of_rest"
    }
  },
  "alchemist": {
    "passive": {
      "name": "Catalyst",
      "description": "While he lives, debuffs on enemies last 30% longer and damage over time hits 30% harder.",
      "catalyst": {
        "durationPercent": 30,
        "dotPercent": 30
      }
    },
    "skills": {
      "attack": "flask_barrage",
      "support": "mystery_brew"
