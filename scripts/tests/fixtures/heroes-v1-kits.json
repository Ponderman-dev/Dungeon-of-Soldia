{
  "_about": "The FIRST hero kits (before the v2 rework): passive + skills per hero. Mechanic tests (channels, cleanse, knockback, counters...) still use them through kitsV1() in util.mjs; the real heroes are tested in heroes-v2.test.mjs.",
  "knight": {
    "passive": {
      "name": "Taunt Wall",
      "description": "10% chance on each attack to taunt the enemy he hit for 3s (it must attack the Knight) and give himself +20 defense for 3s.",
      "procs": [
        {
          "proc": "onAttack",
          "chance": 10,
          "label": "Taunt Wall!",
          "targets": "self",
          "apply": [
            {
              "status": "taunt",
              "durationMs": 3000,
              "to": "target"
            },
            {
              "status": "buff",
              "durationMs": 3000,
              "mods": [
                {
                  "stat": "defense",
                  "flat": 20
                }
              ],
              "to": "self"
            }
          ]
        }
      ]
    },
    "skills": {
      "attack": "ground_pound",
      "support": "rally_cry"
    }
  },
  "berserker": {
    "passive": {
      "name": "Bloodrage",
      "description": "+0.6% attack speed for every 1% of health he is missing (at half health: +30%).",
      "bloodrage": {
        "attackSpeedPercentPerMissing": 0.6
      }
    },
    "skills": {
      "attack": "savage_leap",
      "support": "war_cry"
    }
  },
  "rogue": {
    "passive": {
      "name": "Opportunist",
      "description": "+15% damage and +10 crit against any enemy that has a debuff. His own chance-based debuffs (item procs, crit debuffs) are 25% more likely.",
      "opportunist": {
        "damagePercent": 15,
        "critFlat": 10,
        "debuffChancePercent": 25
      }
    },
    "skills": {
      "attack": "fan_of_knives",
      "support": "smoke_bomb"
    }
  },
  "archer": {
    "passive": {
      "name": "Steady Aim",
      "description": "While he has not been hit for 3s he gets +25% attack speed and +15 crit. Being hit resets it.",
      "steadyAim": {
        "afterMs": 3000,
        "attackSpeedPercent": 25,
        "critFlat": 15
      }
    },
    "skills": {
      "attack": "rain_of_arrows",
      "support": "hunters_mark"
    }
  },
  "samurai": {
    "passive": {
      "name": "Focused Strike",
      "description": "Slow but heavy attacks, 35% chance on each hit to make the enemy bleed, and his own chance-based debuffs are 25% likelier.",
      "focusedStrike": {
        "debuffChancePercent": 25
      },
      "procs": [
        {
          "proc": "onAttack",
          "chance": 35,
          "label": "Bleed!",
          "silent": true,
          "targets": "target",
          "apply": [
            {
              "status": "bleed",
              "durationMs": 5000,
              "damageMultiplier": 0.4
            }
          ]
        }
      ]
    },
    "skills": {
      "attack": "wind_cutter",
      "support": "focus_stance"
    }
  },
  "mage": {
    "passive": {
      "name": "Spellweaver",
