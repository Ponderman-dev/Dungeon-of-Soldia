        "scope": "self",
        "effect": "empower",
        "firedLabel": "Spellweave!",
        "strike": {
          "damageMultiplier": 1.2,
          "damageType": "fire"
        },
        "apply": [
          {
            "status": "burn",
            "durationMs": 4000,
            "damageMultiplier": 0.3
          }
