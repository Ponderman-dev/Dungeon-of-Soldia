        "baseRegenPercentPerSec": 0.3,
        "healMultiplierPercent": 25
      },
      "counter": {
        "id": "mend",
        "label": "MEND",
        "color": "#9fe8a8",
        "every": 4,
        "scope": "self",
        "effect": "heal",
        "firedLabel": "Heal!",
        "heal": {
          "percentMaxHp": 10,
          "attackMultiplier": 1
        }
      }
    },
    "skills": {
      "attack": "smite",
      "support": "divine_shield"
    }
  },
  "necromancer": {
    "passive": {
      "name": "Skeleton Summoner",
      "description": "Raises a skeleton every 8-10s (up to 4); one rises at the start of every floor. They vanish when the floor ends.",
      "spawner": {
        "minion": "skeleton",
        "minMs": 8000,
        "maxMs": 10000,
        "cap": 4,
        "atFloorStart": 1
      }
    },
    "skills": {
      "attack": "death_coil",
      "support": "bone_ward"
    }
  },
  "bard": {
    "passive": {
      "name": "Rhythm",
      "description": "Every 4th basic attack of ANY hero is empowered with a bonus hit (a shared beat for the whole squad).",
      "counter": {
        "id": "rhythm",
        "label": "RHYTHM",
        "color": "#ffb84d",
