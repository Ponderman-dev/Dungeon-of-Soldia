    "heroBack": { "file": "deselect", "volume": 0.6 },
    "cardOpen": { "file": "open", "volume": 0.5 },
    "cardClose": { "file": "close", "volume": 0.45 },
    "scroll": { "file": "swipe", "volume": 0.35 },
    "descend": { "file": "start", "volume": 0.8 },
    "rewardUp": { "file": "open", "volume": 0.5 },
    "rewardCard": { "file": "reward", "volume": 0.5, "pitchJitter": 0.04 },
    "itemGiven": { "file": "purchase", "volume": 0.7 },
    "potion": { "file": "receive", "volume": 0.7 },
    "unlock": { "file": "unlock", "volume": 0.8 },
    "levelUp": { "file": "level-up", "volume": 0.55 },
    "floorClear": { "file": "achievement", "volume": 0.7 },
    "defeat": { "file": "error", "volume": 0.8 },
    "skillReady": { "file": "notification", "volume": 0.3 },
    "skillCast": { "file": "success", "volume": 0.35, "pitchJitter": 0.06 },
