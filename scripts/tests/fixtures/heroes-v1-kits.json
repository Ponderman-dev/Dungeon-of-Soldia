        "forceProcs": true,
        "rotation": [
          {
            "damageType": "fire",
            "color": "#ff9a4d",
            "apply": [
              {
                "status": "burn",
                "durationMs": 4000,
                "damageMultiplier": 0.3
              }
            ]
          },
          {
            "damageType": "ice",
            "color": "#7fd8ff",
            "apply": [
              {
                "status": "chill",
                "durationMs": 6000,
                "stacks": 2
              }
            ]
          },
          {
            "damageType": "electric",
            "color": "#ffe94d",
            "apply": [
              {
                "status": "shock",
                "durationMs": 4000
              }
            ]
          }
        ]
      }
    },
    "skills": {
      "attack": "elemental_rotation",
      "support": "arcane_ward"
    }
  },
  "cleric": {
    "passive": {
      "name": "Mending",
      "description": "While she lives every hero regenerates a little (and regen/heals from items are 25% stronger). Every 4th attack heals the most hurt ally instead of hitting.",
